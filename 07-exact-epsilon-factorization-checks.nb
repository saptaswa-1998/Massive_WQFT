Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Independent", " ", "reconstruction", " ", "and", " ", "exact", " ", 
    "epsilon", " ", "factorization", " ", "of", " ", "the", " ", "cut", " ", 
    RowBox[{"system", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
