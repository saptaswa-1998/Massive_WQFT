Cell[CellGroupData[{
Cell["Exact epsilon-factorization and boundary checks", "Title",ExpressionUUID->"9d38eb98-95e2-4e9b-9999-0401e9022ad6"],

Cell["\<\
End-to-end verification of affine epsilon dependence, complete/incomplete \
elliptic fundamental matrices, determinant normalization, epsilon-independent \
transformed kernels in both parity blocks, the finite-epsilon cut \
differential equation, and the soft/hard boundary data.\
\>", "Text",ExpressionUUID->"7231fda1-e46c-4427-bcfc-01f2628bdb85"],

Cell["\<\
Source:  Evaluate sections in order in a fresh kernel.  External-package \
sections read LIBRA_PATH or LITERED_PATH when those packages are required.\
\>", "Text",ExpressionUUID->"0fff0ba5-64df-4e28-9d54-5d8d8700bc6d"],

Cell[CellGroupData[{

Cell["Exact epsilon-factorization and boundary verification", "Section",ExpressionUUID->"a9aa9129-4314-4146-9280-38f63edf30b0"],

