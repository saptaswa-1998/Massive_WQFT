Cell[CellGroupData[{
Cell["\<\
Twisted Riemann period relations and special-function identities\
\>", "Title",ExpressionUUID->"a670a570-9570-4c40-a587-748a60ecfb05"],

Cell["\<\
Symbolic and high-precision checks of the cocycle and cycle intersection \
matrices, the beta-Appell quadratic identities, cross-channel cancellations, \
beta reflection, and the compact elliptic Legendre limit.\
\>", "Text",ExpressionUUID->"f40a79d5-29b5-42d6-ae1c-bf241752d4b9"],

Cell["\<\
Source: Evaluate sections in order in a fresh kernel.  External-package \
sections read LIBRA_PATH or LITERED_PATH when those packages are required.\
\>", "Text",ExpressionUUID->"328da75e-3958-4617-8c0d-b584c1bc947e"],

