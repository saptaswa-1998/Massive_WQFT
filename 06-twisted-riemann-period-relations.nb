    RowBox[{"2", ",", "wp"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"alpha0", "=", 
    RowBox[{"SetPrecision", "[", 
     RowBox[{
      RowBox[{"{", 
