Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xi", "[", "e_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "Pi", " ", "I", " ", "e"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"iHom", "[", "e_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", "=", 
       RowBox[{"xi", "[", "e", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"q", "-", "1"}], ")"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"q", "+", "1"}], ")"}]}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"q", "+", "1"}], ")"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"q", "-", "1"}], ")"}]}], ")"}]}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"q", "-", "1"}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"q", "/", 
          RowBox[{"(", 
           RowBox[{"q", "-", "1"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"q", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"q", "^", "2"}], "-", "1"}], ")"}]}]}]}], "}"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scalarLhs", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"fMinus", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], ".", 
      RowBox[{"mCoh", "[", "eps0", "]"}], ".", 
      RowBox[{"fPlus", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", "60"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"scalarRhs", "=", 
