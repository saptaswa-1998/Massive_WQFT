       ",", "eb"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ka", "=", 
       RowBox[{"EllipticK", "[", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "tt"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ea", "=", 
       RowBox[{"EllipticE", "[", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "tt"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kb", "=", 
       RowBox[{"EllipticK", "[", 
        RowBox[{"-", "tt"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eb", "=", 
       RowBox[{"EllipticE", "[", 
        RowBox[{"-", "tt"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ka", " ", 
          RowBox[{"eb", "/", 
           RowBox[{"Sqrt", "[", "tt", "]"}]}]}], "+", 
         RowBox[{
          RowBox[{"Sqrt", "[", "tt", "]"}], " ", "kb", " ", "ea"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "tt", "]"}], "+", 
            RowBox[{"1", "/", 
             RowBox[{"Sqrt", "[", "tt", "]"}]}]}], ")"}], " ", "ka", " ", 
          "kb"}], "-", 
         RowBox[{"Pi", "/", "2"}]}], ",", "60"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ellipticResiduals", "=", 
   RowBox[{"ellipticResidualAt", "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "5"}], ",", "1", ",", "2", ",", "7"}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<SCALAR_LHS=\>\"", ",", 
