        RowBox[{"Print", "[", 
         RowBox[{"label", ",", "\"\< = \>\"", ",", 
          RowBox[{"InputForm", "[", 
           RowBox[{"N", "[", 
            RowBox[{"err", ",", "8"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
