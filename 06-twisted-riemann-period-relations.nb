        RowBox[{"-", "1"}], "/", "5"}]}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ellipticResidualAt", "[", "t_", "]"}], ":=", 
   RowBox[{"Module", "[", 
