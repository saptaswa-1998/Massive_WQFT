           RowBox[{"Transpose", "[", "pm", "]"}]}], "-", 
          RowBox[{"2", "Pi", " ", "I", " ", 
           RowBox[{"coh", "[", "ee", "]"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<factor-free Appell relation\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", "qm", "]"}], ".", 
           RowBox[{"m", "[", "ee", "]"}], ".", "qp"}], "-", 
          RowBox[{"dd", ".", 
           RowBox[{"rhs", "[", "ee", "]"}], ".", 
           RowBox[{"Inverse", "[", "dd", "]"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"target", "=", 
        RowBox[{
         RowBox[{"-", "8"}], 
         RowBox[{"Pi", "^", "3"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "ee"}], "+", "3"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"ee", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", 
               RowBox[{"ee", "^", "2"}]}], "-", "1"}], ")"}], 
            RowBox[{"Sin", "[", 
             RowBox[{"2", "Pi", " ", "ee"}], "]"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<determinant relative error\>\"", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Det", "[", "qp", "]"}], 
             RowBox[{"Det", "[", "qm", "]"}]}], "-", "target"}], ")"}], "/", 
          "target"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<beta reflection\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Beta", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "ee"}], "-", 
              RowBox[{"1", "/", "2"}]}], ",", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "2"}]}], "]"}], 
           RowBox[{"Beta", "[", 
            RowBox[{
             RowBox[{"ee", "+", 
              RowBox[{"1", "/", "2"}]}], ",", 
             RowBox[{"1", "/", "2"}]}], "]"}]}], "-", 
          RowBox[{"4", "Pi", 
           RowBox[{"(", 
            RowBox[{"ee", "+", "1"}], ")"}], 
           RowBox[{
            RowBox[{"Tan", "[", 
             RowBox[{"Pi", " ", "ee"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "ee"}], "+", "1"}], ")"}]}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<trigonometric conversion\>\"", ",", 
         RowBox[{
          RowBox[{"2", "Pi", " ", "I", " ", 
           RowBox[{"Transpose", "[", "hh", "]"}]}], "-", 
          RowBox[{"rhs", "[", "ee", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<elliptic degeneration\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"EllipticK", "[", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "tt"}], "]"}], 
           RowBox[{
            RowBox[{"EllipticE", "[", 
             RowBox[{"-", "tt"}], "]"}], "/", 
            RowBox[{"Sqrt", "[", "tt", "]"}]}]}], "+", 
          RowBox[{
           RowBox[{"Sqrt", "[", "tt", "]"}], 
           RowBox[{"EllipticK", "[", 
            RowBox[{"-", "tt"}], "]"}], 
           RowBox[{"EllipticE", "[", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "tt"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sqrt", "[", "tt", "]"}], "+", 
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", "tt", "]"}]}]}], ")"}], 
           RowBox[{"EllipticK", "[", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "tt"}], "]"}], 
           RowBox[{"EllipticK", "[", 
            RowBox[{"-", "tt"}], "]"}]}], "-", 
          RowBox[{"Pi", "/", "2"}]}]}], "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"sample", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"1", "/", "7"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "5"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", 
            RowBox[{"2", "/", "9"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"3", "/", "2"}], ",", 
            RowBox[{
             RowBox[{"1", "/", "9"}], "+", 
             RowBox[{"I", "/", "30"}]}]}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"failed", ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<COMPLETION_CHECK=FAIL\>\"", "]"}], ";", 
       RowBox[{"Quit", "[", "1", "]"}]}], ",", 
      RowBox[{"Print", "[", "\"\<COMPLETION_CHECK=PASS\>\"", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
