  ";"}], "\n", 
 RowBox[{
  RowBox[{"scalarResidual", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"scalarLhs", "-", "scalarRhs"}], ",", "50"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scalarResidualAt", "[", 
    RowBox[{"t_", ",", "e_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tau0", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"t", ",", "wp"}], "]"}]}], ",", 
       RowBox[{"eps0", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"e", ",", "wp"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fp", ",", "fm"}], "}"}], ",", 
       RowBox[{
        RowBox[{"fp", "=", 
         RowBox[{"periodColumn", "[", 
          RowBox[{"1", ",", 
           RowBox[{"alphaPlus", "[", "eps0", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fm", "=", 
         RowBox[{"periodColumn", "[", 
          RowBox[{"1", ",", 
           RowBox[{"-", 
            RowBox[{"alphaPlus", "[", "eps0", "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fm", ".", 
            RowBox[{"mCoh", "[", "eps0", "]"}], ".", "fp"}], "+", 
           RowBox[{"Pi", " ", 
            RowBox[{"Tan", "[", 
             RowBox[{"Pi", " ", "eps0"}], "]"}]}]}], ",", "45"}], "]"}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sampleResiduals", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"scalarResidualAt", "[", 
      RowBox[{
       RowBox[{"1", "/", "5"}], ",", 
       RowBox[{"1", "/", "7"}]}], "]"}], ",", 
