  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"upperPower", "[", 
     RowBox[{
      RowBox[{"q_", "?", "NumericQ"}], ",", 
      RowBox[{"a_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Re", "[", "q", "]"}], ">=", "0"}], ",", 
      RowBox[{"q", "^", "a"}], ",", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "Pi", " ", "a"}], "]"}], " ", 
