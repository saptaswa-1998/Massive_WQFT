Notebook[
 {Cell[CellGroupData[
    {Cell["Exact monodromy and invariant bilinear-form checks", "Title"], 
     Cell["Exact checks of the orbit-basis monodromy matrices and twisted \
bilinear pairing. Evaluate the sections in order in a fresh kernel. No \
external package is required.", "Text"], 
     Cell[CellGroupData[{Cell["Setup", "Section"], Cell["We use zeta = Exp[I \
Pi d], with d = 4 - 2 eps. Monodromy acts from the right. The ordered \
singular points are 0, -3/4, -1, infinity; zeta is nonzero, and the pairing \
is nondegenerate for zeta != 1, -1.", "Text"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
                 "\"AncillaryExact04`*\"", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"checks", "=", RowBox[{"Association", "[", "]"}]}], 
               ";", "\[IndentingNewLine]", RowBox[{RowBox[{"zeroQ", "[", 
                   "x_", "]"}], ":=", RowBox[{"And", "@@", RowBox[
                    {RowBox[{"(", RowBox[{RowBox[{"TrueQ", "[", RowBox[
                          {RowBox[{"Together", "[", "#1", "]"}], "\[Equal]", 
                          "0"}], "]"}], "&"}], ")"}], "/@", RowBox[
                      {"Flatten", "[", RowBox[{"{", "x", "}"}], "]"}]}]}]}], 
               ";", "\[IndentingNewLine]", RowBox[{RowBox[{"assert", "[", 
                   RowBox[{"name_", ",", "test_"}], "]"}], ":=", 
                 RowBox[{"If", "[", RowBox[{RowBox[{"TrueQ", "[", "test", 
                       "]"}], ",", RowBox[{RowBox[{"AssociateTo", "[", 
                         RowBox[{"checks", ",", RowBox[{"name", "\[Rule]", 
                          "True"}]}], "]"}], ";", "\[IndentingNewLine]", 
                       RowBox[{"Print", "[", RowBox[{"name", ",", 
                          "\" = PASS\""}], "]"}]}], ",", RowBox[
                      {RowBox[{"Print", "[", RowBox[{"name", ",", 
                          "\" = FAIL: \"", ",", StyleBox["test", 
                          ShowStringCharacters -> True, NumberMarks -> 
                          True]}], "]"}], ";", "\[IndentingNewLine]", 
                       RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", RowBox[{"id", "=", RowBox[
                  {"IdentityMatrix", "[", "3", "]"}]}], ";", 
               "\[IndentingNewLine]"}]], "Input"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["Exact reconstruction in the orbit basis", 
         "Section"], Cell["The transported rank-one data below are \
reconstructed from the independent local-series calculation in notebook 05. \
This cell assembles the four matrices algebraically: rho0 = I/zeta + \
(1-1/zeta)e1 l0, rhoH = I + uH vH, rhoMinusOne = I + uM vM, and rhoInfinity = \
-I + uInfinity vInfinity. These data, rather than the sphere relation, are \
the input to this exact reconstruction. The intermediate l0 has a pole at \
zeta = 1, but the assembled rho0 has a finite limit.", "Text"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"id", "=", 
                 RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";", 
               "\[IndentingNewLine]", RowBox[{"e1", "=", RowBox[
                  {"{", RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", 
               "\[IndentingNewLine]", RowBox[{"l0", "=", RowBox[
                  {"{", RowBox[{"1", ",", RowBox[{RowBox[{"2", " ", "zeta"}], 
                       "+", "1"}], ",", RowBox[{"-", FractionBox[RowBox[
                         {"zeta", "+", "3"}], RowBox[{"zeta", "-", 
                          "1"}]]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"uHOrbit", "=", RowBox[{"{", RowBox[{RowBox[{"-", 
