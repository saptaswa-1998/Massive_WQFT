 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"P0", "[", "tau_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p1A", "[", "tau", "]"}], ",", 
        RowBox[{"p1B", "[", "tau", "]"}], ",", 
        RowBox[{"r1", "[", "tau", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p3A", "[", "tau", "]"}], ",", 
        RowBox[{"p3B", "[", "tau", "]"}], ",", 
        RowBox[{"r3", "[", "tau", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"tau", "/", "3"}], " ", 
          RowBox[{"p1A", "[", "tau", "]"}]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "tau"}], ")"}], "/", "3"}], " ", 
          RowBox[{"p3A", "[", "tau", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"tau", "/", "3"}], " ", 
          RowBox[{"p1B", "[", "tau", "]"}]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "tau"}], ")"}], "/", "3"}], " ", 
          RowBox[{"p3B", "[", "tau", "]"}]}]}], ",", 
        RowBox[{"r5", "[", "tau", "]"}]}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "period", " ", "equations", " ", 
     RowBox[{"Pell", "'"}]}], "=", 
    RowBox[{"Cmat", ".", "Pell"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"periodDerivativeRules", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"p1A", "'"}], "[", "tau", "]"}], "->", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cmat", "[", "tau", "]"}], ".", 
          RowBox[{"Pell", "[", "tau", "]"}]}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p1B", "'"}], "[", "tau", "]"}], "->", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cmat", "[", "tau", "]"}], ".", 
          RowBox[{"Pell", "[", "tau", "]"}]}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p3A", "'"}], "[", "tau", "]"}], "->", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cmat", "[", "tau", "]"}], ".", 
          RowBox[{"Pell", "[", "tau", "]"}]}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p3B", "'"}], "[", "tau", "]"}], "->", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cmat", "[", "tau", "]"}], ".", 
          RowBox[{"Pell", "[", "tau", "]"}]}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Equations", " ", "defining", " ", "qA", " ", "and", " ", "qB"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"qDerivativeRules", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"qA", "'"}], "[", "tau", "]"}], "->", 
       RowBox[{"6", " ", 
        RowBox[{
         RowBox[{"w", "[", "tau", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "tau"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"3", "+", 
             RowBox[{"4", " ", "tau"}]}], ")"}], " ", 
           RowBox[{"deltaEll", "[", "tau", "]"}]}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"p3B", "[", "tau", "]"}], "/", "tau"}], "+", 
          RowBox[{"p1B", "[", "tau", "]"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"qB", "'"}], "[", "tau", "]"}], "->", 
       RowBox[{"6", " ", 
        RowBox[{
         RowBox[{"w", "[", "tau", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "tau"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"3", "+", 
             RowBox[{"4", " ", "tau"}]}], ")"}], " ", 
           RowBox[{"deltaEll", "[", "tau", "]"}]}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"p3A", "[", "tau", "]"}]}], "/", "tau"}], "-", 
          RowBox[{"p1A", "[", "tau", "]"}]}], ")"}]}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allDerivativeRules", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"periodDerivativeRules", ",", "qDerivativeRules"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Direct", " ", "substitution", " ", "into", " ", "the", " ", 
    "differential", " ", "equation"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rawResidual", "=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"P0", "[", "tau", "]"}], ",", "tau"}], "]"}], "-", 
     RowBox[{
      RowBox[{"A0", "[", "tau", "]"}], ".", 
      RowBox[{"P0", "[", "tau", "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"residual", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Together", "[", 
       RowBox[{"rawResidual", "/.", " ", "allDerivativeRules"}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tau", ">", "0"}], ",", 
         RowBox[{"tauStar", ">", "0"}], ",", 
         RowBox[{
          RowBox[{"deltaEll", "[", "tau", "]"}], "!=", "0"}]}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<P0 = \>\"", ",", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"P0", "[", "tau", "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Residual = \>\"", ",", 
     RowBox[{"MatrixForm", "[", "residual", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pass", "=", 
    RowBox[{"SameQ", "[", 
     RowBox[{"residual", ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
