Cell[CellGroupData[{

Cell["Legendre relation in reciprocal negative parameters", "Section",ExpressionUUID->"29e6cef4-fa66-4db7-837d-bd4558a6ff10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "elliptic", " ", "integrals"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ka", "[", "tau_", "]"}], ":=", 
   RowBox[{"EllipticK", "[", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "tau"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ea", "[", "tau_", "]"}], ":=", 
    RowBox[{"EllipticE", "[", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "tau"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Kb", "[", "tau_", "]"}], ":=", 
   RowBox[{"EllipticK", "[", 
    RowBox[{"-", "tau"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Eb", "[", "tau_", "]"}], ":=", 
    RowBox[{"EllipticE", "[", 
     RowBox[{"-", "tau"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Left", "-", 
    RowBox[{"hand", " ", "side", " ", "of", " ", "the", " ", "identity"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lhs", "[", "tau_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Ka", "[", "tau", "]"}], " ", 
   RowBox[{
    RowBox[{"Eb", "[", "tau", "]"}], "/", 
    RowBox[{"Sqrt", "[", "tau", "]"}]}]}]}], "\n", 
 RowBox[{
  RowBox[{"+", 
   RowBox[{"Sqrt", "[", "tau", "]"}]}], " ", 
  RowBox[{"Kb", "[", "tau", "]"}], " ", 
  RowBox[{"Ea", "[", "tau", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sqrt", "[", "tau", "]"}], "+", 
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "tau", "]"}]}]}], ")"}]}], " ", 
    RowBox[{"Ka", "[", "tau", "]"}], " ", 
    RowBox[{"Kb", "[", "tau", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Check", " ", "the", " ", "identity"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"lhs", "[", "tau", "]"}], "-", 
    RowBox[{"Pi", "/", "2"}]}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"tau", ">", "0"}]}]}], "]"}]}], "Input",ExpressionUUID->"886a42bf-\
8fa2-4d33-ba4b-fa496ed1dd09"],

Cell[BoxData[
 RowBox[{
  SqrtBox["tau"], " ", 
  RowBox[{"EllipticE", "[", 
   RowBox[{"-", 
    FractionBox["1", "tau"]}], "]"}], " ", 
  RowBox[{"EllipticK", "[", 
   RowBox[{"-", "tau"}], "]"}]}]], "Output",ExpressionUUID->"7b45c1dd-99d7-\
4f16-99a0-37fe9bcb6550"],

