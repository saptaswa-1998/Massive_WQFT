Notebook[{

Cell[CellGroupData[{
Cell["Elliptic fundamental matrix and Legendre-relation checks", "Title",ExpressionUUID->"7a12dd58-04af-4343-a2df-2814ba7afef2"],

Cell["\<\
Direct verification of the three-dimensional epsilon=0 fundamental matrix, \
first with abstract period equations and then with complete and incomplete \
elliptic integrals.  The determinant and Legendre relation are checked in the \
conventions of the draft.\
\>", "Text",ExpressionUUID->"988d8972-d728-442b-baa0-e0d6e6afe9d8"],

Cell["\<\
Source: Checks_Elliptic.nb.  Evaluate sections in order in a fresh kernel.  \
External-package sections read LIBRA_PATH or LITERED_PATH when those packages \
are required.\
\>", "Text",ExpressionUUID->"87a50052-e752-4ff0-aa91-8d8f788a789e"],

Cell[CellGroupData[{

Cell["Abstract three-dimensional completion", "Section",ExpressionUUID->"615222a3-e379-49b2-945b-bfcb6b75de96"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "tau", ",", "tauStar", ",", "g", ",", "A0", ",", "Cmat", ",", "Pell", ",",
      "deltaEll", ",", "w", ",", "p1A", ",", "p1B", ",", "p3A", ",", "p3B", 
     ",", "qA", ",", "qB", ",", "r1", ",", "r3", ",", "r5", ",", "P0"}], 
    "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", 
     RowBox[{"epsilon", "^", "0"}], " ", "differential"}], "-", 
    RowBox[{"equation", " ", "matrix"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "tau_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "tau"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"3", "+", 
       RowBox[{"4", " ", "tau"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"A0", "[", "tau_", "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"g", "[", "tau", "]"}]}], " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "tau"}], "-", 
          RowBox[{"7", "/", "2"}]}], ",", 
         RowBox[{"2", "-", 
          RowBox[{"11", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "tau"}], ")"}]}]}], ",", 
         RowBox[{"6", "/", "tau"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "3"}], "/", "2"}], ",", 
         RowBox[{
          RowBox[{"11", "/", "2"}], "-", 
          RowBox[{"2", " ", "tau"}]}], ",", 
         RowBox[{"-", "6"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", " ", 
          RowBox[{"tau", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "9"}], " ", "tau"}], "-", 
          RowBox[{"3", "/", "2"}]}], ",", 
         RowBox[{"6", " ", "tau"}]}], "}"}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"The", " ", "2", "x2", " ", "elliptic", " ", "connection"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Cmat", "[", "tau_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "tau"}], ")"}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "tau", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "tau"}], ")"}]}], ")"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "tau"}], ")"}]}], ")"}]}], ",", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "tau"}], ")"}]}], ")"}]}]}], "}"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"A", "-", 
    RowBox[{"and", " ", "B"}], "-", 
    RowBox[{"cycle", " ", "elliptic", " ", "periods"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Pell", "[", "tau_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p1A", "[", "tau", "]"}], ",", 
        RowBox[{"p1B", "[", "tau", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p3A", "[", "tau", "]"}], ",", 
        RowBox[{"p3B", "[", "tau", "]"}]}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"deltaEll", "[", "tau_", "]"}], ":=", 
    RowBox[{"Det", "[", 
     RowBox[{"Pell", "[", "tau", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
   "\n", 
  RowBox[{"(*", 
   RowBox[{"Transverse", " ", "scalar", " ", "solution"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", "tau_", "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"4", " ", "tau"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"4", " ", "tauStar"}]}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Entries", " ", "of", " ", "the", " ", "auxiliary", " ", "third", " ", 
    "column"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"r1", "[", "tau_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"p1A", "[", "tau", "]"}], " ", 
      RowBox[{"qA", "[", "tau", "]"}]}], "+", 
     RowBox[{
      RowBox[{"p1B", "[", "tau", "]"}], " ", 
      RowBox[{"qB", "[", "tau", "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"r3", "[", "tau_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"p3A", "[", "tau", "]"}], " ", 
      RowBox[{"qA", "[", "tau", "]"}]}], "+", 
     RowBox[{
      RowBox[{"p3B", "[", "tau", "]"}], " ", 
      RowBox[{"qB", "[", "tau", "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"r5", "[", "tau_", "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"tau", "/", "3"}], " ", 
       RowBox[{"r1", "[", "tau", "]"}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "tau"}], ")"}], "/", "3"}], " ", 
       RowBox[{"r3", "[", "tau", "]"}]}], "+", 
      RowBox[{"w", "[", "tau", "]"}]}], ")"}]}], ";"}], "\[IndentingNewLine]",
   "\n", 
  RowBox[{"(*", 
   RowBox[{"Explicit", " ", "3", "x3", " ", "fundamental", " ", "matrix"}], 
