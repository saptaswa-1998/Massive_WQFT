Cell["Exact rank-one reconstruction", "Section",ExpressionUUID->"33bfa5ab-64d3-455c-b664-cd29a9ec3e28"],

Cell["\<\
The following rank-one factors display the algebraic structure of the \
reconstructed result and are checked against rhoDerived. Notebook 04 uses the \
same factors for its exact invariance checks.\
\>", "Text",ExpressionUUID->"627bd4c1-8c20-4403-9928-287f4845e02c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e1", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{
      RowBox[{"2", " ", "zeta"}], "+", "1"}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"zeta", "+", "3"}], 
       RowBox[{"zeta", "-", "1"}]]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uHOrbit", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vHOrbit", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"-", 
      SuperscriptBox["zeta", "2"]}], ",", 
     RowBox[{"-", 
      FractionBox["1", "zeta"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uMOrbit", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vMOrbit", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["zeta", "2"]}], "+", "zeta", "+", "1"}], ",", "1"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uInfinityOrbit", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "zeta"}], "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"zeta", "+", "1"}], ")"}]}], ",", "1", ",", 
     RowBox[{"-", "zeta"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vInfinityOrbit", "=", 
   FractionBox[
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["zeta", "2"]}], "+", "zeta", "+", "1"}], ",", 
      RowBox[{"zeta", "+", "2"}]}], "}"}], 
    SuperscriptBox["zeta", "2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho0", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{
     FractionBox["id", "zeta"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox["1", "zeta"]}], ")"}], " ", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "e1", ",", "l0"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoH", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{"id", "+", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "uHOrbit", ",", "vHOrbit"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoMinusOne", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{"id", "+", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "uMOrbit", ",", "vMOrbit"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoInfinity", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{
     RowBox[{"-", "id"}], "+", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "uInfinityOrbit", ",", "vInfinityOrbit"}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoList", "=", 
   RowBox[{"{", 
    RowBox[{"rho0", ",", "rhoH", ",", "rhoMinusOne", ",", "rhoInfinity"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", 
