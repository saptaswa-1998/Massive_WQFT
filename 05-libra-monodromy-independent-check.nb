Cell[CellGroupData[{

Cell["Local series and upper-side branch convention", "Section",ExpressionUUID->"b4c3cd9c-8ee0-46a1-85c4-6910c3879e46"],

Cell["\<\
At every finite center p the coordinate is tau-p. Principal logarithms and \
powers are used. For a negative real argument -s, the value is the upper-side \
limit Log[-s + I 0] = Log[s] + I Pi. Real-axis matching points are therefore \
understood as boundary values from the upper half-plane. At infinity the \
coordinate is 1/tau. Dual series supply inverse fundamental matrices through \
transposition.\
\>", "Text",ExpressionUUID->"76dca357-61fa-4ffe-87a8-28e12fbd9146"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"precision", "=", "85"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"guardPrecision", "=", "140"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centers", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", 
      FractionBox["7", "8"]}], ",", 
     RowBox[{"-", 
      FractionBox["3", "4"]}], ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}], ",", "0", ",", 
     FractionBox["1", "2"], ",", "2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"series", "[", "p", "]"}], "=", 
      RowBox[{"Libra`SeriesSolutionData", "[", 
       RowBox[{"Ahat", ",", 
        RowBox[{"{", 
         RowBox[{"tau", ",", 
          RowBox[{"tau", "-", "p"}]}], "}"}], ",", 
        RowBox[{"Monitor", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dual", "[", "p", "]"}], "=", 
      RowBox[{"Libra`SeriesSolutionData", "[", 
       RowBox[{
        RowBox[{"-", 
         TemplateBox[{"Ahat"},
          "Transpose"]}], ",", 
        RowBox[{"{", 
         RowBox[{"tau", ",", 
          RowBox[{"tau", "-", "p"}]}], "}"}], ",", 
        RowBox[{"Monitor", "\[Rule]", "False"}]}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"p", ",", "centers"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"series", "[", "\[Infinity]", "]"}], "=", 
   RowBox[{"Libra`SeriesSolutionData", "[", 
    RowBox[{"Ahat", ",", 
     RowBox[{"{", 
      RowBox[{"tau", ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Monitor", "\[Rule]", "False"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"links", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["7", "8"]}], ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", 
        FractionBox["11", "12"]}], ",", "300"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["3", "4"]}], ",", 
       RowBox[{"-", 
        FractionBox["7", "8"]}], ",", 
       RowBox[{"-", 
        FractionBox["5", "6"]}], ",", "300"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{"-", 
        FractionBox["3", "4"]}], ",", 
       RowBox[{"-", 
        FractionBox["5", "8"]}], ",", "420"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{"-", 
        FractionBox["3", "8"]}], ",", "420"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "\[Infinity]", ",", 
       FractionBox["19", "10"], ",", "420"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "2"], ",", "2", ",", 
       FractionBox["4", "5"], ",", "340"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", "2"], ",", 
       FractionBox["3", "10"], ",", "300"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<NEGATIVE_ARGUMENT_UPPER_SIDE\>\"", ",", 
    RowBox[{"TrueQ", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"-", "1"}], "]"}], "\[Equal]", 
      RowBox[{"\[ImaginaryI]", " ", "\[Pi]"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"construct", "[", 
