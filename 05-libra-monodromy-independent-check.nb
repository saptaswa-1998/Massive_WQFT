Cell[BoxData[{
 RowBox[{
  RowBox[{"connections", "=", 
   RowBox[{"{", "A", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"totalT", "=", "id"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"current", "=", 
      RowBox[{"Last", "[", "connections", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"source", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"k", "\[LessEqual]", "2"}], ",", "\[Infinity]", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"target", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"k", "\[LessEqual]", "2"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", 
         FractionBox["3", "4"]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sourceResidue", "=", 
      RowBox[{"residue", "[", 
       RowBox[{"current", ",", "source"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"targetResidue", "=", 
      RowBox[{"residue", "[", 
       RowBox[{"current", ",", "target"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
      RowBox[{
       RowBox[{"\"\<SOURCE_COMPATIBILITY_\>\"", "<>", 
        RowBox[{"ToString", "[", "k", "]"}]}], ",", 
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"id", "-", 
           RowBox[{"P", "[", "k", "]"}]}], ")"}], ".", "sourceResidue", ".", 
         RowBox[{"P", "[", "k", "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
      RowBox[{
       RowBox[{"\"\<TARGET_COMPATIBILITY_\>\"", "<>", 
        RowBox[{"ToString", "[", "k", "]"}]}], ",", 
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{"P", "[", "k", "]"}], ".", "targetResidue", ".", 
         RowBox[{"(", 
          RowBox[{"id", "-", 
           RowBox[{"P", "[", "k", "]"}]}], ")"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"next", "=", 
      RowBox[{"Together", "[", 
       RowBox[{"Libra`Transform", "[", 
        RowBox[{"current", ",", 
         RowBox[{"T", "[", "k", "]"}], ",", "tau"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"connections", ",", "next"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"totalT", "=", 
      RowBox[{"Together", "[", 
       RowBox[{"totalT", ".", 
        RowBox[{"T", "[", "k", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"poleRanks", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Libra`PoincareRank", "[", 
          RowBox[{"next", ",", 
           RowBox[{"{", 
            RowBox[{"tau", ",", "#1"}], "}"}]}], "]"}], "&"}], ")"}], "/@", 
       "points"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
      RowBox[{
       RowBox[{"\"\<ALL_POLES_SIMPLE_AFTER_\>\"", "<>", 
        RowBox[{"ToString", "[", "k", "]"}]}], ",", 
       RowBox[{"poleRanks", "===", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"spectrumHistory", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Factor", "/@", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"residue", "[", 
             RowBox[{"next", ",", "#1"}], "]"}], "]"}]}], "&"}], ")"}], "/@", 
        "points"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ahat", "=", 
   RowBox[{"Last", "[", "connections", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transformedResidues", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"p", "\[Rule]", 
       RowBox[{"Factor", "[", 
