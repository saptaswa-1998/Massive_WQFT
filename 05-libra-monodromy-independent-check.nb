Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Balance\"\>", "\<\"Matrix with d = 4 - 2 eps\"\>"},
    {"1", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
