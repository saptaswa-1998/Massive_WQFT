      RowBox[{"\"\<Point\>\"", ",", "\"\<Derived rho\>\""}], "}"}]}], "]"}], 
   ",", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
   RowBox[{"Spacings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"40084dd8-30ef-457e-bc58-d586668f2161"],

