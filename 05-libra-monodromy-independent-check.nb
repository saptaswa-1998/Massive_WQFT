Cell[CellGroupData[{

Cell["Transformed residues and local logarithmic model", "Section",ExpressionUUID->"7ce09614-20da-409e-9528-314860f4de2e"],

Cell["\<\
All residues used below are recomputed from Ahat. The gauge is meromorphic in \
d and singular at d = 1, 3, 4, so its construction is carried out at generic \
dimension. Exceptional-dimensional limits require the original system or the \
final monodromy formulas. Normalized Fuchsian form means absence of \
nonzero-integer differences between residue eigenvalues; it does not mean an \
epsilon form.\
\>", "Text",ExpressionUUID->"b7d1de18-c5c5-4907-bb04-5e5776831f89"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"uH", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", 
     FractionBox[
      RowBox[{
       RowBox[{"5", " ", "d"}], "-", "12"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}]]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vH", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"d", "-", "6"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"d", "-", "3"}], ")"}]}]]}], ",", 
     FractionBox[
      RowBox[{
       RowBox[{"41", " ", 
        SuperscriptBox["d", "3"]}], "-", 
       RowBox[{"504", " ", 
        SuperscriptBox["d", "2"]}], "+", 
       RowBox[{"1976", " ", "d"}], "-", "2424"}], 
      RowBox[{"6", " ", 
       RowBox[{"(", 
        RowBox[{"d", "-", "4"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"d", "-", "3"}], ")"}]}]], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"d", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"7", " ", 
           SuperscriptBox["d", "2"]}], "-", 
          RowBox[{"69", " ", "d"}], "+", "169"}], ")"}]}], 
       RowBox[{"3", " ", 
        RowBox[{"(", 
         RowBox[{"d", "-", "4"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"d", "-", "3"}], ")"}]}]]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uM", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox[
      RowBox[{
       RowBox[{"5", " ", "d"}], "-", "23"}], 
      RowBox[{"d", "-", "3"}]], ",", 
     FractionBox[
      RowBox[{
       RowBox[{"7", " ", 
        SuperscriptBox["d", "2"]}], "-", 
       RowBox[{"49", " ", "d"}], "+", "78"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"d", "-", "3"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}]]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vM", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "6"], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"28", " ", 
         SuperscriptBox["d", "2"]}], "-", 
        RowBox[{"201", " ", "d"}], "+", "324"}], 
       RowBox[{"18", " ", 
        RowBox[{"(", 
         RowBox[{"d", "-", "4"}], ")"}]}]]}], ",", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"5", " ", "d"}], "-", "24"}], ")"}]}], 
      RowBox[{"9", " ", 
       RowBox[{"(", 
        RowBox[{"d", "-", "4"}], ")"}]}]]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<RESIDUE_ZERO\>\"", ",", 
    RowBox[{"zeroQ", "[", 
     RowBox[{
      RowBox[{"transformedResidues", "[", "0", "]"}], "-", 
      RowBox[{"originalResidues", "[", "0", "]"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<RESIDUE_H\>\"", ",", 
    RowBox[{"zeroQ", "[", 
     RowBox[{
      RowBox[{"transformedResidues", "[", 
       RowBox[{"-", 
        FractionBox["3", "4"]}], "]"}], "-", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "uH", ",", "vH"}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<RESIDUE_MINUS_ONE\>\"", ",", 
    RowBox[{"zeroQ", "[", 
     RowBox[{
      RowBox[{"transformedResidues", "[", 
       RowBox[{"-", "1"}], "]"}], "-", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "uM", ",", "vM"}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<H_EXPONENT\>\"", ",", 
    RowBox[{"zeroQ", "[", 
     RowBox[{
      RowBox[{"vH", ".", "uH"}], "-", 
      RowBox[{"(", 
       RowBox[{"d", "-", 
        FractionBox["11", "2"]}], ")"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<MINUS_ONE_NILPOTENT\>\"", ",", 
    RowBox[{"zeroQ", "[", 
     RowBox[{
      RowBox[{"transformedResidues", "[", 
       RowBox[{"-", "1"}], "]"}], ".", 
      RowBox[{"transformedResidues", "[", 
       RowBox[{"-", "1"}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ninf", "=", 
   RowBox[{"Together", "[", 
    RowBox[{
     RowBox[{"transformedResidues", "[", "\[Infinity]", "]"}], "-", 
     FractionBox["id", "2"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<INFINITY_NILPOTENT\>\"", ",", 
    RowBox[{"zeroQ", "[", 
     RowBox[{"Ninf", ".", "Ninf"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<INFINITY_NILPOTENT_RANK_ONE\>\"", ",", 
    RowBox[{
     RowBox[{"MatrixRank", "[", "Ninf", "]"}], "\[Equal]", "1"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"infinityModel", "=", 
   RowBox[{
    SqrtBox["t"], " ", 
    RowBox[{"(", 
     RowBox[{"id", "+", 
      RowBox[{"Ninf", " ", 
       RowBox[{"Log", "[", "t", "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assert", "[", 
   RowBox[{"\"\<INFINITY_LEVELT_MODEL\>\"", ",", 
    RowBox[{"zeroQ", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], "infinityModel"}], "-", 
      FractionBox[
       RowBox[{
        RowBox[{"transformedResidues", "[", "\[Infinity]", "]"}], ".", 
        "infinityModel"}], "t"]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"localInfinity", "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"id", "+", 
      RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]", " ", "Ninf"}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", 
         TagBox[
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"transformedResidues", "[", "p", "]"}], "/.", 
            "\[VeryThinSpace]", 
            RowBox[{"d", "\[Rule]", 
             RowBox[{"4", "-", 
              RowBox[{"2", " ", "eps"}]}]}]}], "]"}],
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "points"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Point\>\"", ",", "\"\<Transformed residue in eps\>\""}], 
      "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
   RowBox[{"Spacings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"01a2eff0-b695-4eda-a05b-5b610e5b8ae2"],

