Notebook[{

Cell[CellGroupData[{
Cell["Independent Libra monodromy and Levelt check", "Title",ExpressionUUID->"2688a0a4-5fe4-4fce-8b97-230bd8ce0170"],

Cell["\<\
Four balance transformations and independent reconstruction of all four \
monodromy matrices from Libra local series. Evaluate the sections in order in \
a fresh kernel. The saved outputs use Mathematica 14.1 and Libra 1.23.\
\>", "Text",ExpressionUUID->"3e3304db-23de-4a6a-82b5-c88fd57b7da7"],

Cell[CellGroupData[{

Cell["Setup and Libra", "Section",ExpressionUUID->"32680e29-a26d-46c0-8b1f-81a1bfbd2a92"],

Cell["\<\
Libra is loaded directly below. Change the path in Get to your own Libra.m \
installation when running on another computer.\
\>", "Text",ExpressionUUID->"7e0aebe6-ef77-45b7-9338-42204f124b98"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<AncillaryLibra05`*\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"Association", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroQ", "[", "x_", "]"}], ":=", 
   RowBox[{"And", "@@", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{
         RowBox[{"Together", "[", "#1", "]"}], "\[Equal]", "0"}], "]"}], 
       "&"}], ")"}], "/@", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", "x", "}"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"assert", "[", 
    RowBox[{"name_", ",", "test_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "test", "]"}], ",", 
     RowBox[{
      RowBox[{"AssociateTo", "[", 
       RowBox[{"checks", ",", 
        RowBox[{"name", "\[Rule]", "True"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"name", ",", "\"\< = PASS\>\""}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"name", ",", "\"\< = FAIL: \>\"", ",", 
        StyleBox["test",
         ShowStringCharacters->True,
         NumberMarks->True]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "<<", "\"\</Users/saptaswaghosh/Downloads/Libra-master/Source/Libra.m\>\""}]\
, ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"66048e3a-aa8b-4889-ab49-2d2959cc26c8"],

