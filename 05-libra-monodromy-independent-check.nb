        RowBox[{"ToString", "[", 
         RowBox[{"testDimension", ",", "InputForm"}], "]"}]}], ",", 
       RowBox[{"sphereResidual", "<", 
        FractionBox["1", 
         SuperscriptBox["10", "30"]]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"verificationResults", ",", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<Dimension\>\"", "\[Rule]", "testDimension"}], ",", 
