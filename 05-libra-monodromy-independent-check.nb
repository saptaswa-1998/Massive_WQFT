Cell[CellGroupData[{

Cell["Differential equation and original residue data", "Section",ExpressionUUID->"9b0f6a0b-57e5-4621-9315-545a085da785"],

Cell["\<\
The convention is J' = A J, with d = 4 - 2 eps. A prime denotes \
differentiation with respect to tau. The residue at infinity is minus the \
coefficient of 1/tau, corresponding to the local coordinate t = 1/tau.\
\>", "Text",ExpressionUUID->"8262f148-44e2-41f9-9056-afae0949b072"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "tau"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"3", "+", 
      RowBox[{"4", " ", "tau"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a0", "=", 
   FractionBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "tau"}], "-", 
         FractionBox["7", "2"]}], ",", 
        RowBox[{"2", "-", 
         FractionBox["11", 
          RowBox[{"2", " ", "tau"}]]}], ",", 
        FractionBox["6", "tau"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["3", "2"]}], ",", 
        RowBox[{
         FractionBox["11", "2"], "-", 
         RowBox[{"2", " ", "tau"}]}], ",", 
        RowBox[{"-", "6"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{"3", " ", "tau"}], "2"], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "9"}], " ", "tau"}], "-", 
         FractionBox["3", "2"]}], ",", 
        RowBox[{"6", " ", "tau"}]}], "}"}]}], "}"}], "g"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a1", "=", 
   FractionBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         FractionBox["8", "tau"], "+", "4"}], ",", 
        RowBox[{"-", 
         FractionBox["4", "tau"]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         FractionBox["3", "tau"], "-", "1"}], ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"tau", "-", "3"}], ",", 
        RowBox[{
         FractionBox["3", "tau"], "+", "7"}]}], "}"}]}], "}"}], "g"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"Together", "[", 
    RowBox[{"a0", "+", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"4", "-", "d"}], ")"}], " ", "a1"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Aepsilon", "=", 
   RowBox[{"Together", "[", 
    RowBox[{"A", "/.", "\[VeryThinSpace]", 
     RowBox[{"d", "\[Rule]", 
      RowBox[{"4", "-", 
       RowBox[{"2", " ", "eps"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", 
      FractionBox["3", "4"]}], ",", 
     RowBox[{"-", "1"}], ",", "\[Infinity]"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residue", "[", 
    RowBox[{"m_", ",", "p_"}], "]"}], ":=", 
   RowBox[{"Together", "[", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"p", "===", "\[Infinity]"}], ",", 
      RowBox[{"-", 
       RowBox[{"SeriesCoefficient", "[", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"tau", ",", "\[Infinity]", ",", "1"}], "}"}]}], "]"}]}], 
      ",", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"tau", ",", "p", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalResidues", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"p", "\[Rule]", 
       RowBox[{"residue", "[", 
        RowBox[{"A", ",", "p"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", "points"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectrumHistory", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Factor", "/@", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"originalResidues", "[", "#1", "]"}], "]"}]}], "&"}], ")"}], 
     "/@", "points"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"23a3da89-1420-435c-aeeb-ccf77352da9a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four compatible balance transformations", "Section",ExpressionUUID->"abf9ed4c-2cc9-4023-8ee3-1ddb7cc3e28b"],

Cell["\<\
The projector vectors are specified explicitly. Libra constructs P = u \
v/(v.u) and the corresponding balances. The first two balances are between \
infinity and -1. The last two are between -1 and -3/4; their constant \
normalization is chosen so that each balance equals the identity at tau = 0.\
\>", "Text",ExpressionUUID->"00509be5-f570-47b1-bf29-5f13e6dea3cb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "1", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", "1", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", 
     RowBox[{"1", "-", 
      RowBox[{"4", " ", "d"}]}], ",", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{"d", "-", "1"}], ")"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "2", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{"d", "-", "1"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"4", " ", "d"}], "-", "9"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", "2", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "3", "]"}], "=", 
   RowBox[{"u", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", "3", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "3"}], ",", 
     RowBox[{
      RowBox[{"5", " ", "d"}], "-", "12"}], ",", 
     RowBox[{
      RowBox[{"-", "4"}], " ", 
      RowBox[{"(", 
       RowBox[{"d", "-", "1"}], ")"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "4", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{"d", "-", "1"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"5", " ", "d"}], "-", "12"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", "4", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"3", " ", 
      RowBox[{"(", 
       RowBox[{"d", "-", "4"}], ")"}]}], ",", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"28", " ", 
         SuperscriptBox["d", "2"]}], "-", 
        RowBox[{"201", " ", "d"}], "+", "324"}], ")"}]}], ",", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{"d", "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"5", " ", "d"}], "-", "24"}], ")"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"P", "[", "k", "]"}], "=", 
      RowBox[{"Together", "[", 
       RowBox[{"Libra`Projector", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u", "[", "k", "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", "[", "k", "]"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
      RowBox[{
       RowBox[{"\"\<PROJECTOR_\>\"", "<>", 
        RowBox[{"ToString", "[", "k", "]"}]}], ",", 
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"P", "[", "k", "]"}], ".", 
          RowBox[{"P", "[", "k", "]"}]}], "-", 
         RowBox[{"P", "[", "k", "]"}]}], "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", "1", "]"}], "=", 
   RowBox[{"Libra`Balance", "[", 
    RowBox[{
     RowBox[{"P", "[", "1", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"tau", ",", "\[Infinity]", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", "2", "]"}], "=", 
   RowBox[{"Libra`Balance", "[", 
    RowBox[{
     RowBox[{"P", "[", "2", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"tau", ",", "\[Infinity]", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", "3", "]"}], "=", 
   RowBox[{"Libra`Balance", "[", 
    RowBox[{
     RowBox[{"P", "[", "3", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"tau", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", 
        FractionBox["3", "4"]}]}], "}"}], ",", 
     FractionBox["4", "3"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", "4", "]"}], "=", 
   RowBox[{"Libra`Balance", "[", 
    RowBox[{
     RowBox[{"P", "[", "4", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"tau", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", 
        FractionBox["3", "4"]}]}], "}"}], ",", 
     FractionBox["4", "3"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"assert", "[", 
     RowBox[{
      RowBox[{"\"\<BALANCE_FORM_\>\"", "<>", 
       RowBox[{"ToString", "[", "k", "]"}]}], ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"T", "[", "k", "]"}], "-", "id", "-", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"k", "\[LessEqual]", "2"}], ",", "tau", ",", 
           FractionBox["tau", 
            RowBox[{"3", " ", 
             RowBox[{"(", 
              RowBox[{"tau", "+", "1"}], ")"}]}]]}], "]"}], " ", 
         RowBox[{"P", "[", "k", "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         TagBox[
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"T", "[", "k", "]"}], "/.", "\[VeryThinSpace]", 
            RowBox[{"d", "\[Rule]", 
             RowBox[{"4", "-", 
              RowBox[{"2", " ", "eps"}]}]}]}], "]"}],
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Balance\>\"", ",", "\"\<Matrix with d = 4 - 2 eps\>\""}], 
      "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
   RowBox[{"Spacings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"f682d4b2-e157-4673-b926-025d121d4979"],

