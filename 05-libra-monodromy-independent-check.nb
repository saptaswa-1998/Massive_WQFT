Cell[CellGroupData[{

Cell["Rational reconstruction", "Section",ExpressionUUID->"04e78d80-4fc1-4ef1-9f31-6d4a01a8c280"],

Cell["\<\
No candidate rho matrices are loaded before transport. Each entry is \
reconstructed at d=-I/Pi, where zeta=E, using FindIntegerNullVector with \
numerator degree at most four and denominator degree at most two. The \
resulting formulas are tested at d=-2 I/Pi. This is numerical rational \
reconstruction, not an analytic proof of the unrestricted functional \
dependence on d.\
\>", "Text",ExpressionUUID->"aa8ae36e-5100-4c8d-a480-2d35da9877d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"recognize", "[", 
     RowBox[{"value_", ",", "zetaValue_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"yy", ",", "relation", ",", "aa", ",", "bb", ",", "answer"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "value", "]"}], "<", 
          FractionBox["1", 
           SuperscriptBox["10", "35"]]}], ",", 
         RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"Im", "[", "value", "]"}], "]"}], ">", 
          FractionBox["1", 
           SuperscriptBox["10", "30"]]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yy", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"Re", "[", "value", "]"}], ",", "55"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"relation", "=", 
        RowBox[{"FindIntegerNullVector", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{
               SuperscriptBox["zetaValue", "j"], ",", "55"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "0", ",", "4"}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"yy", " ", 
                SuperscriptBox["zetaValue", "j"]}], ",", "55"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"relation", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"aa", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"relation", ",", "5"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"bb", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"relation", ",", 
          RowBox[{"-", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"bb", "===", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"answer", "=", 
        RowBox[{"Factor", "[", 
         RowBox[{"Cancel", "[", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"j", "=", "0"}], "4"], 
             RowBox[{
              RowBox[{"aa", "\[LeftDoubleBracket]", 
               RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], " ", 
              SuperscriptBox["zeta", "j"]}]}], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"j", "=", "0"}], "2"], 
             RowBox[{
              RowBox[{"bb", "\[LeftDoubleBracket]", 
               RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], " ", 
              SuperscriptBox["zeta", "j"]}]}]]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"answer", "/.", "\[VeryThinSpace]", 
               RowBox[{"zeta", "\[Rule]", "zetaValue"}]}], ",", "55"}], "]"}],
             "-", "value"}], "]"}], ">", 
          FractionBox["1", 
           SuperscriptBox["10", "30"]]}], ",", "$Failed", ",", "answer"}], 
        "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"daadd412-4128-4b9c-ac1f-c698b9a37fac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Independent transport of all four monodromies", "Section",ExpressionUUID->"1466993a-26cc-4006-ad7b-f7450c175636"],

Cell["\<\
For each dimension, the overlap matrices are recomputed from the local \
series. The infinity generator is transported along infinity -> 2 -> 1/2 -> \
0; it is not obtained from the sphere relation. All generators first enter \
the same zero-centered reference basis. The orbit columns are vStar, \
rhoH.vStar, rhoMinusOne.vStar, with vStar = {1,0,0}. Only afterwards are \
matrices compared with the displayed formulas.\
\>", "Text",ExpressionUUID->"47ceb1b0-0314-4008-9d0c-21b74c21ee13"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"verificationResults", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"dValue", "=", 
      RowBox[{"N", "[", 
       RowBox[{"testDimension", ",", "guardPrecision"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"zetaValue", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", "dValue"}], "]"}], ",", 
        "guardPrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<DIMENSION = \>\"", ",", 
       StyleBox["testDimension",
        ShowStringCharacters->True,
        NumberMarks->True]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"right", ",", "left", ",", "match", ",", "terms"}], "}"}], 
         "=", "link"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rightValue", "=", 
         RowBox[{"match", "-", "right"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"leftValue", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"left", "===", "\[Infinity]"}], ",", 
           FractionBox["1", "match"], ",", 
           RowBox[{"match", "-", "left"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"U", "[", 
          RowBox[{"right", ",", "left"}], "]"}], "=", 
         RowBox[{
          TemplateBox[{
            RowBox[{"construct", "[", 
              RowBox[{
                RowBox[{"dual", "[", "right", "]"}], ",", "rightValue", ",", 
                "terms"}], "]"}]},
           "Transpose"], ".", 
          RowBox[{"construct", "[", 
           RowBox[{
            RowBox[{"series", "[", "left", "]"}], ",", "leftValue", ",", 
            "terms"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"link", ",", "links"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uh", "=", 
      TemplateBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"U", "[", 
              RowBox[{"0", ",", 
                RowBox[{"-", 
                  FractionBox["1", "2"]}]}], "]"}], ".", 
            RowBox[{"U", "[", 
              RowBox[{
                RowBox[{"-", 
                  FractionBox["1", "2"]}], ",", 
                RowBox[{"-", 
                  FractionBox["3", "4"]}]}], "]"}]}], ")"}]},
       "Inverse"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"um", "=", 
      TemplateBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"U", "[", 
              RowBox[{"0", ",", 
                RowBox[{"-", 
                  FractionBox["1", "2"]}]}], "]"}], ".", 
            RowBox[{"U", "[", 
              RowBox[{
                RowBox[{"-", 
                  FractionBox["1", "2"]}], ",", 
                RowBox[{"-", 
                  FractionBox["3", "4"]}]}], "]"}], ".", 
            RowBox[{"U", "[", 
              RowBox[{
                RowBox[{"-", 
                  FractionBox["3", "4"]}], ",", 
                RowBox[{"-", 
                  FractionBox["7", "8"]}]}], "]"}], ".", 
            RowBox[{"U", "[", 
              RowBox[{
                RowBox[{"-", 
                  FractionBox["7", "8"]}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], ")"}]},
       "Inverse"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ui", "=", 
      TemplateBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"U", "[", 
              RowBox[{"0", ",", 
                FractionBox["1", "2"]}], "]"}], ".", 
            RowBox[{"U", "[", 
              RowBox[{
                FractionBox["1", "2"], ",", "2"}], "]"}], ".", 
            RowBox[{"U", "[", 
              RowBox[{"2", ",", "\[Infinity]"}], "]"}]}], ")"}]},
       "Inverse"]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"local", "[", "p_", "]"}], ":=", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"transformedResidues", "[", "p", "]"}], "/.", 
           "\[VeryThinSpace]", 
           RowBox[{"d", "\[Rule]", "dValue"}]}], ",", "precision"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"localValues", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Values", "[", "localMonodromies", "]"}], "/.", 
         "\[VeryThinSpace]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"d", "\[Rule]", "dValue"}], ",", 
           RowBox[{"zeta", "\[Rule]", "zetaValue"}]}], "}"}]}], ",", 
        "precision"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
      RowBox[{
       RowBox[{"\"\<LOCAL_EXPONENTIALS_\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"testDimension", ",", "InputForm"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"localValues", "-", 
            RowBox[{"local", "/@", "points"}]}], "]"}], "]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "30"]]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"common", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
        "localValues", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
         ",", 
        RowBox[{
         TemplateBox[{"uh"},
          "Inverse"], ".", 
         RowBox[{
         "localValues", "\[LeftDoubleBracket]", "2", 
          "\[RightDoubleBracket]"}], ".", "uh"}], ",", 
        RowBox[{
         TemplateBox[{"um"},
          "Inverse"], ".", 
         RowBox[{
         "localValues", "\[LeftDoubleBracket]", "3", 
          "\[RightDoubleBracket]"}], ".", "um"}], ",", 
        RowBox[{
         TemplateBox[{"ui"},
          "Inverse"], ".", 
         RowBox[{
         "localValues", "\[LeftDoubleBracket]", "4", 
          "\[RightDoubleBracket]"}], ".", "ui"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vStar", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
      RowBox[{"\"\<REFERENCE_SEED\>\"", ",", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "common", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            ".", "vStar"}], "-", "vStar"}], "]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "30"]]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cLee", "=", 
      TemplateBox[{
        RowBox[{"{", 
          RowBox[{"vStar", ",", 
            RowBox[{
              
              RowBox[{"common", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}], ".", "vStar"}], ",", 
            RowBox[{
              
              RowBox[{"common", "\[LeftDoubleBracket]", "3", 
                "\[RightDoubleBracket]"}], ".", "vStar"}]}], "}"}]},
       "Transpose"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"numericalOrbit", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          TemplateBox[{"cLee"},
           "Inverse"], ".", "#1", ".", "cLee"}], "&"}], ")"}], "/@", 
       "common"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"testDimension", "===", 
        RowBox[{"-", 
         FractionBox["\[ImaginaryI]", "\[Pi]"]}]}], ",", 
       RowBox[{
        RowBox[{"recognized", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"recognize", "[", 
             RowBox[{"#1", ",", "zetaValue"}], "]"}], "&"}], ",", 
           "numericalOrbit", ",", 
           RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"assert", "[", 
         RowBox[{"\"\<RECOGNITION_NO_FAILED_ENTRIES\>\"", ",", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"recognized", ",", "$Failed"}], "]"}]}], "]"}]}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"expectedOrbit", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"recognized", "/.", "\[VeryThinSpace]", 
         RowBox[{"zeta", "\[Rule]", "zetaValue"}]}], ",", "precision"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"residual", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"numericalOrbit", "-", "expectedOrbit"}], "]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ALL_FOUR_ORBIT_RESIDUAL = \>\"", ",", 
       StyleBox["residual",
        ShowStringCharacters->True,
        NumberMarks->True]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
      RowBox[{
       RowBox[{"\"\<INDEPENDENT_ALL_FOUR_TRANSPORT_\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"testDimension", ",", "InputForm"}], "]"}]}], ",", 
       RowBox[{"residual", "<", 
        FractionBox["1", 
         SuperscriptBox["10", "30"]]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sphereResidual", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Dot", "@@", "common"}], "-", "id"}], "]"}], "]"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<NUMERICAL_SPHERE_RESIDUAL = \>\"", ",", 
       StyleBox["sphereResidual",
        ShowStringCharacters->True,
        NumberMarks->True]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"assert", "[", 
