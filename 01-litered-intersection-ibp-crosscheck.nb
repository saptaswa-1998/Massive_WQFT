Notebook[{

Cell[CellGroupData[{
Cell["\<\
LiteRed, intersection theory, and twisted-exact IBP cross-check\
\>", "Title",ExpressionUUID->"10ebd2bf-83f0-490f-b347-d9d740c2f17e"],

Cell["\<\
Independent three-way reduction of the ISP numerator (l1.v2)^5 on the maximal \
cut.  The notebook compares the local intersection recursion, a global \
twisted-exact certificate, and a LiteRed reduction after the common cut \
projection and basis map.\
\>", "Text",ExpressionUUID->"b43f1dc4-4768-472c-8df9-d80251b88e4f"],

Cell["\<\
Source: Checks_Elliptic.nb.  Evaluate sections in order in a fresh kernel.  \
External-package sections read LIBRA_PATH or LITERED_PATH when those packages \
are required.\
\>", "Text",ExpressionUUID->"21884901-c28a-4303-873c-550813689d57"],

Cell[CellGroupData[{

Cell["Complete three-way maximal-cut reduction", "Section",ExpressionUUID->"77330050-32a6-4009-84ed-1d9ce9912254"],

Cell[CellGroupData[{

