Cell["Twisted-exact certificates for the basis transformation", "Section",ExpressionUUID->"eb69e1b8-9732-4f6e-b15b-378f9a81684b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Extract", " ", "the", " ", "twisted"}], "-", 
    RowBox[{"exact", " ", "zero"}], "-", 
    RowBox[{
    "forms", " ", "q_i", " ", "using", " ", "the", " ", "already", " ", 
     "computed", " ", 
     RowBox[{"R", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"extractQ", "[", 
      RowBox[{"f_", ",", "rCoefficients_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "qVars", ",", "q", ",", "rPoly", ",", "numerator", ",", "equations", 
         ",", "solution", ",", "residual"}], "}"}], ",", 
       RowBox[{
        RowBox[{"qVars", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Unique", "[", "\"\<q\>\"", "]"}], "&"}], ",", "6", ",", 
           "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"q", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"qVars", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
            RowBox[{"z", "^", "k"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "5"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rPoly", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rCoefficients", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
            RowBox[{"z", "^", "k"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numerator", "=", 
         RowBox[{"Expand", "@", 
          RowBox[{"Numerator", "@", 
           RowBox[{"Together", "[", 
            RowBox[{"f", "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"q", ",", "z"}], "]"}], "+", 
               RowBox[{"omegaCoefficient", " ", "q"}]}], ")"}], "-", 
             "rPoly"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"equations", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"CoefficientList", "[", 
            RowBox[{"numerator", ",", "z"}], "]"}], "==", "0"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"solution", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Solve", "[", 
           RowBox[{"equations", ",", "qVars"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"residual", "=", 
         RowBox[{"Factor", "@", 
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"f", "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"q", ",", "z"}], "]"}], "+", 
               RowBox[{"omegaCoefficient", " ", "q"}]}], ")"}], "-", 
             "rPoly"}], "/.", " ", "solution"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"residual", "=!=", "0"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Q_EXTRACTION_RESIDUAL=\>\"", ",", 
             RowBox[{"InputForm", "[", "residual", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Quit", "[", "1", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Factor", "[", 
         RowBox[{"Together", "[", 
          RowBox[{"q", "/.", " ", "solution"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"qFunctions", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{"extractQ", ",", 
         RowBox[{"{", 
          RowBox[{"eCoefficients", ",", "rOrthonormalToMonomial"}], "}"}]}], 
        "]"}], "/.", 
       RowBox[{"tau", "->", "\[Tau]"}]}], "/.", 
      RowBox[{"eps", "->", "\[Epsilon]"}]}], "//", "FullSimplify"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<q_\>\"", ",", "i", ",", "\"\<(z)=\>\"", ",", 
         RowBox[{"InputForm", "[", 
          RowBox[{"qFunctions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "qFunctions", "]"}]}], "}"}]}], "]"}], "//", 
     "TraditionalForm"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[115]:=",ExpressionUUID->"fe94ecc3-bc8b-4707-ade7-e267a61b9bb8"],

