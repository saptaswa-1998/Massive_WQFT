Notebook[{

Cell[CellGroupData[{
Cell["Orthogonal dlog basis and Gauss-Manin checks", "Title",ExpressionUUID->"21c987df-ab0e-4878-be77-a66288e75842"],

Cell["\<\
Construction of the orthogonal dlog connection, its projection to the \
monomial cocycle basis, twisted-exact certificates for the transformation \
rows, and the direct gauge-transformation identity between the two \
Gauss-Manin matrices.\
\>", "Text",ExpressionUUID->"2dbff003-21ae-4094-a30d-831ef4486932"],

Cell["\<\
Source: Checks_Elliptic.nb.  Evaluate sections in order in a fresh kernel.  \
External-package sections read LIBRA_PATH or LITERED_PATH when those packages \
are required.\
\>", "Text",ExpressionUUID->"9d209adb-d122-46e0-8631-7d916007f712"],

Cell[CellGroupData[{

Cell["Intersection construction of the orthogonal dlog connection", "Section",ExpressionUUID->"8b42ca95-2de7-4c08-bf73-7aed20537567"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Verify", " ", "the", " ", "orthonormal", " ", "dlog", " ", "basis", " ",
       "e_i"}], "=", 
     RowBox[{"dlog", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "-", "z_i"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"z", "-", 
         RowBox[{"z_", "6"}]}], ")"}]}], "]"}]}], ",", 
    RowBox[{"h_i", "=", 
     RowBox[{"Res_", 
      RowBox[{"{", 
       RowBox[{"z", "=", "z_i"}], "}"}], 
      RowBox[{"(", "omega", ")"}], " ", 
      RowBox[{"dlog", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"z", "-", "z_i"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"z", "-", 
          RowBox[{"z_", "7"}]}], ")"}]}], "]"}]}]}], ",", 
    RowBox[{
     RowBox[{"with", " ", "z_", "6"}], "=", 
     RowBox[{
      RowBox[{"infinity", " ", "and", " ", "z_", "7"}], "=", "1."}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"den", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"z", "^", "2"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "2"}], "+", "tau"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", " ", 
          RowBox[{"z", "^", "2"}]}], "-", "3"}], ")"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"omegaCoefficient", "=", 
     RowBox[{"Together", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "z", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"eps", "-", 
           RowBox[{"1", "/", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"z", "^", "2"}]}], ")"}]}]}], "-", 
       RowBox[{"2", " ", "z", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"eps", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"z", "^", "2"}], "+", "tau"}], ")"}]}]}], "-", 
       RowBox[{"8", " ", "eps", " ", 
        RowBox[{"z", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", " ", 
            RowBox[{"z", "^", "2"}]}], "-", "3"}], ")"}]}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"I", " ", 
      RowBox[{"Sqrt", "[", "tau", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"basisPoles", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "h"}], ",", "h", ",", "r", ",", 
       RowBox[{"-", "r"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"leftReference", "=", "Infinity"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rightReference", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"twistResidues", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eps", "-", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"-", "eps"}], ",", 
       RowBox[{"-", "eps"}], ",", 
       RowBox[{
        RowBox[{"-", "eps"}], "-", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"-", "eps"}], "-", 
        RowBox[{"1", "/", "2"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"With", " ", "z_", "6"}], "=", "infinity"}], ",", 
     RowBox[{
      RowBox[{"dlog", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"z", "-", "z_i"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"z", "-", 
          RowBox[{"z_", "6"}]}], ")"}]}], "]"}], " ", "is", " ", "dlog", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "-", "z_i"}], ")"}], "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"eCoefficients", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"z", "-", "#"}], ")"}]}], "&"}], "/@", "basisPoles"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"hCoefficients", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"z", "-", "#1"}], ")"}]}], "-", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"z", "-", "rightReference"}], ")"}]}]}], ")"}]}], "&"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"basisPoles", ",", "twistResidues"}], "}"}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tauLogDerivative", "=", 
     RowBox[{
      RowBox[{"eps", "/", "tau"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"eps", "+", 
         RowBox[{"1", "/", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "2"}], "+", "tau"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gaussManinCoefficients", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"eCoefficients", ",", "tau"}], "]"}], "+", 
        RowBox[{"tauLogDerivative", " ", "eCoefficients"}]}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"tau", ">", "0"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"punctures", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"I", " ", 
        RowBox[{"Sqrt", "[", "tau", "]"}]}], ",", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"Sqrt", "[", "tau", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}], ",", "Infinity"}], 
      "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"toLocal", "[", 
      RowBox[{"formCoefficient_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"p", "===", "Infinity"}], ",", 
       RowBox[{"Together", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"formCoefficient", "/.", " ", 
           RowBox[{"z", "->", 
            RowBox[{"1", "/", "x"}]}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           RowBox[{"x", "^", "2"}]}], ")"}]}], "]"}], ",", 
       RowBox[{"Together", "[", 
        RowBox[{"formCoefficient", "/.", " ", 
         RowBox[{"z", "->", 
          RowBox[{"p", "+", "x"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"localIntersectionContribution", "[", 
      RowBox[{"left_", ",", "right_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "wLocal", ",", "leftLocal", ",", "rightLocal", ",", "cm", ",", "c0", 
         ",", "psi", ",", "equation", ",", "solution", ",", "contribution"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"wLocal", "=", 
         RowBox[{"Normal", "@", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"toLocal", "[", 
             RowBox[{"omegaCoefficient", ",", "p"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "0"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"leftLocal", "=", 
         RowBox[{"Normal", "@", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"toLocal", "[", 
             RowBox[{"left", ",", "p"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightLocal", "=", 
         RowBox[{"Normal", "@", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"toLocal", "[", 
             RowBox[{"right", ",", "p"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "0"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"psi", "=", 
         RowBox[{
          RowBox[{"cm", "/", "x"}], "+", "c0"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"equation", "=", 
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"psi", ",", "x"}], "]"}], "+", 
           RowBox[{"wLocal", " ", "psi"}], "-", "leftLocal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solution", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{"equation", ",", "x", ",", 
                 RowBox[{"-", "2"}]}], "]"}], "==", "0"}], ",", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{"equation", ",", "x", ",", 
                 RowBox[{"-", "1"}]}], "]"}], "==", "0"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"cm", ",", "c0"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"contribution", "=", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"psi", "/.", " ", "solution"}], ")"}], " ", 
             "rightLocal"}], "]"}], ",", "x", ",", 
           RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Factor", "[", 
         RowBox[{"Together", "[", "contribution", "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"intersectionPair", "[", 
      RowBox[{"left_", ",", "right_"}], "]"}], ":=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"localIntersectionContribution", "[", 
           RowBox[{"left", ",", "right", ",", "#"}], "]"}], "&"}], "/@", 
         "punctures"}], "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"tau", ">", "0"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cOrthonormal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"intersectionPair", "[", 
        RowBox[{
         RowBox[{"eCoefficients", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"hCoefficients", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaOrthonormal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"intersectionPair", "[", 
        RowBox[{
         RowBox[{"gaussManinCoefficients", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"hCoefficients", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaOrthonormal", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"omegaOrthonormal", ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"tau", ">", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Closed", " ", "pole"}], "-", 
     RowBox[{
     "data", " ", "form", " ", "of", " ", "the", " ", "same", " ", "Gauss"}], 
     "-", 
     RowBox[{"Manin", " ", 
      RowBox[{"connection", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"allFinitePoles", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"basisPoles", ",", "rightReference"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allFiniteResidues", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"twistResidues", ",", 
       RowBox[{"eps", "-", 
        RowBox[{"1", "/", "2"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"poleVelocities", "=", 
     RowBox[{"D", "[", 
      RowBox[{"allFinitePoles", ",", "tau"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rightReferenceIndex", "=", "6"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kCoefficient", "[", 
      RowBox[{"i_", ",", "a_"}], "]"}], ":=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"allFiniteResidues", "[", 
         RowBox[{"[", "a", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"poleVelocities", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "-", 
           RowBox[{"poleVelocities", "[", 
            RowBox[{"[", "a", "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"allFinitePoles", "[", 
            RowBox[{"[", "a", "]"}], "]"}], "-", 
           RowBox[{"allFinitePoles", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"tau", ">", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaPoleFormula", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "j"}], ",", 
         RowBox[{
          RowBox[{"eps", "/", "tau"}], "-", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"a", "==", "i"}], ",", "0", ",", 
              RowBox[{"kCoefficient", "[", 
               RowBox[{"i", ",", "a"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"a", ",", "1", ",", 
              RowBox[{"Length", "[", "allFinitePoles", "]"}]}], "}"}]}], 
           "]"}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"twistResidues", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "/", 
            RowBox[{"allFiniteResidues", "[", 
             RowBox[{"[", "rightReferenceIndex", "]"}], "]"}]}], " ", 
           RowBox[{"kCoefficient", "[", 
            RowBox[{"i", ",", "rightReferenceIndex"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"kCoefficient", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"twistResidues", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "/", 
            RowBox[{"allFiniteResidues", "[", 
             RowBox[{"[", "rightReferenceIndex", "]"}], "]"}]}], " ", 
           RowBox[{"kCoefficient", "[", 
            RowBox[{"i", ",", "rightReferenceIndex"}], "]"}]}]}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaPoleFormula", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"omegaPoleFormula", ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"tau", ">", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"poleFormulaDifference", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"omegaPoleFormula", "-", "omegaOrthonormal"}], "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"tau", ">", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Independently", " ", "project", " ", "e_i", " ", "to", " ", "the", " ", 
     "monomial", " ", 
     RowBox[{"cocycles", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"reduceToMonomial", "[", "f_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "qVars", ",", "rVars", ",", "q", ",", "rPoly", ",", "numerator", ",", 
         "equations", ",", "solution", ",", "residual"}], "}"}], ",", 
       RowBox[{
        RowBox[{"qVars", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Unique", "[", "\"\<q\>\"", "]"}], "&"}], ",", "6", ",", 
           "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rVars", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Unique", "[", "\"\<r\>\"", "]"}], "&"}], ",", "5", ",", 
           "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"q", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"qVars", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
            RowBox[{"z", "^", "k"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "5"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rPoly", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rVars", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
            RowBox[{"z", "^", "k"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numerator", "=", 
         RowBox[{"Expand", "@", 
          RowBox[{"Numerator", "@", 
           RowBox[{"Together", "[", 
            RowBox[{"f", "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"q", ",", "z"}], "]"}], "+", 
               RowBox[{"omegaCoefficient", " ", "q"}]}], ")"}], "-", 
             "rPoly"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"equations", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"CoefficientList", "[", 
            RowBox[{"numerator", ",", "z"}], "]"}], "==", "0"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"solution", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Solve", "[", 
           RowBox[{"equations", ",", 
            RowBox[{"Join", "[", 
             RowBox[{"qVars", ",", "rVars"}], "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"residual", "=", 
         RowBox[{"Factor", "@", 
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"f", "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"q", ",", "z"}], "]"}], "+", 
               RowBox[{"omegaCoefficient", " ", "q"}]}], ")"}], "-", 
             "rPoly"}], "/.", " ", "solution"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"residual", "=!=", "0"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<REDUCTION_RESIDUAL=\>\"", ",", 
             RowBox[{"InputForm", "[", "residual", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Quit", "[", "1", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Factor", "/@", 
         RowBox[{"(", 
